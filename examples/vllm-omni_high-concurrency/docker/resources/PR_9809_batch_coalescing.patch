+    assert s.schedule().num_scheduled_tokens == {"0": 8}
+
+
+def test_v1_pause_does_not_keep_a_stale_deadline(monkeypatch):
+    s, clock = scheduler(monkeypatch)
+    assert not s.schedule().num_scheduled_tokens
